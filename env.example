PLEX_BASE_URL=http://YOUR_PLEX_IP:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN
SECRET_KEY=RANDOM_SECRET_KEY_OF_YOUR_CHOICE
ASSETS_DIR=/path/to/your/assets
# Optional: password to protect the app (recommended if it is reachable from the Internet)
APP_PASSWORD=
# Optional: set to 1 to stop ArtLayerr from checking GitHub for new versions
DISABLE_UPDATE_CHECK=
# Optional: recompute the dashboard automatically every X hours (e.g. 6). Empty or 0 = off (manual Update only)
AUTO_REFRESH_HOURS=
